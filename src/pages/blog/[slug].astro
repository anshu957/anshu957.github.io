---
import CardPlate from "../../components/blog/CardPlate.astro";
import Comments from "../../components/blog/Comments.astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ManuscriptHeader from "../../components/manuscript/ManuscriptHeader.astro";
import ManuscriptFooter from "../../components/manuscript/ManuscriptFooter.astro";
import Sidenote from "../../components/Sidenote.astro";
import { siteMeta } from "../../data/site.js";
import { domainColor, tagLabel } from "../../lib/domainColor.js";
import "../../styles/manuscript.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatDate = (date) =>
  date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const tags = post.data.tags ?? [];
const color = domainColor(tags);
const primaryTag = tagLabel(tags[0]);
// Keywords keep their acronyms upright: "rna velocity" -> "RNA velocity".
const keyword = (t) => tagLabel(t).replace(/\b(rna|dna|ai|ml)\b/gi, (m) => m.toUpperCase());
---

<BaseLayout title={`${post.data.title} | ${siteMeta.name}`} description={post.data.description}>
  <div class="manuscript-page">
    <div class="ms-shell">
      <ManuscriptHeader currentPath="/blog" />

      <article class:list={["ms-article-shell", `ms-article-shell--${color}`]}>
        <nav class="ms-article-crumb" aria-label="Breadcrumb">
          <a href="/">index</a>
          <span aria-hidden="true">/</span>
          <span class="ms-article-crumb-domain">{primaryTag}</span>
          <span aria-hidden="true">/</span>
          <span class="ms-article-crumb-title">{post.data.title}</span>
        </nav>

        <header class="ms-article-header">
          <figure class="ms-article-plate ms-glass-plate">
            <CardPlate image={post.data.image} eager />
          </figure>

          <div class="ms-article-title-card">
            <p class="ms-article-domain">
              <span>{formatDate(post.data.date)}</span>
              <span aria-hidden="true">/</span>
              <span>{post.data.readingTime}</span>
              <span aria-hidden="true">/</span>
              <span>{primaryTag}</span>
            </p>
            <h1 class="ms-article-title">{post.data.title}</h1>
            <p class="ms-article-lede">{post.data.description}</p>
          </div>
        </header>

        <div class="ms-article-reading-grid">
          <aside class="ms-article-reader-rail" aria-label="Reading details">
            <p class="ms-article-reader-label">Keywords</p>
            <p class="ms-article-tags">{tags.slice(0, 4).map(keyword).join("; ")}</p>
          </aside>

          <div class="ms-article-prose">
            <Content components={{ Sidenote }} />
            {post.data.comments && <Comments slug={post.slug} />}
          </div>
        </div>
      </article>

      <ManuscriptFooter />
    </div>
  </div>
</BaseLayout>

<style>
  .ms-article-shell {
    --article-accent: var(--ms-accent);
    position: relative;
    padding: clamp(1rem, 2.3vw, 1.8rem) 0 clamp(3rem, 6vw, 4.8rem);
  }

  .ms-article-crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
    margin-bottom: clamp(0.85rem, 1.8vw, 1.2rem);
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .ms-article-crumb a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .ms-article-crumb a:hover,
  .ms-article-crumb a:focus-visible {
    color: var(--article-accent);
    opacity: 1;
  }

  .ms-article-crumb-domain {
    color: var(--article-accent);
    opacity: 0.88;
  }

  .ms-article-crumb-title {
    color: var(--ms-primary);
    opacity: 0.78;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .ms-article-header {
    display: grid;
    grid-template-columns:
      clamp(17rem, 28vw, 23rem)
      minmax(0, 1fr);
    gap: clamp(1.15rem, 2.5vw, 2rem);
    align-items: center;
    padding: clamp(1rem, 2.2vw, 1.6rem) 0 clamp(1.5rem, 3vw, 2.3rem);
    border-bottom: 1px solid var(--ms-rule);
  }

  /* Glass plate (.ms-glass-plate) holding the post's figure. Two theme variants of
     the art are swapped by the .dark class. */
  .ms-article-plate {
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    padding: clamp(0.5rem, 1.5vw, 1rem);
  }

  :global(.ms-plate-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(.ms-plate-img--dark) { display: none; }
  html.dark :global(.ms-plate-img--light) { display: none; }
  html.dark :global(.ms-plate-img--dark) { display: block; }

  .ms-article-title-card {
    min-width: 0;
    padding: 0.2rem 0 0.2rem clamp(0.9rem, 1.8vw, 1.15rem);
    border-left: 2px solid color-mix(in srgb, var(--article-accent) 44%, transparent);
  }

  .ms-article-domain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.36rem;
    margin: 0 0 0.55rem;
    color: var(--article-accent);
    font-family: var(--ms-font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .ms-article-title {
    max-width: 22ch;
    margin: 0 0 0.65rem;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: var(--fs-h1);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .ms-article-lede {
    max-width: 34rem;
    margin: 0;
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-body);
    font-size: var(--fs-body);
    font-style: italic;
    font-weight: 500;
    line-height: 1.32;
    text-wrap: pretty;
  }

  .ms-article-reader-label {
    margin: 0 0 0.32rem;
    color: var(--article-accent);
    font-family: var(--ms-font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .ms-article-reading-grid {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 67ch);
    gap: clamp(1.2rem, 3vw, 2rem);
    align-items: start;
    padding-top: clamp(1.45rem, 3vw, 2.3rem);
  }

  .ms-article-reader-rail {
    position: sticky;
    top: 1rem;
    margin: 0;
    padding-top: 0.35rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .ms-article-reader-rail p {
    margin: 0;
  }

  /* Keywords, set the way a journal article lists them. */
  .ms-article-tags {
    margin: 0.55rem 0 0;
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-body);
    font-size: var(--fs-note);
    letter-spacing: normal;
    line-height: 1.5;
    text-transform: none;
  }

  .ms-article-prose {
    --article-accent: inherit;
    position: relative;
    max-width: 67ch;
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .ms-article-prose :global(p),
  .ms-article-prose :global(ul),
  .ms-article-prose :global(ol),
  .ms-article-prose :global(blockquote) {
    margin: 0 0 1.45rem;
  }

  .ms-article-prose :global(a) {
    color: var(--article-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .ms-article-prose :global(a:hover) {
    color: var(--ms-accent-strong);
  }

  .ms-article-prose :global(h2),
  .ms-article-prose :global(h3) {
    color: var(--ms-primary);
    text-wrap: balance;
  }

  .ms-article-prose :global(h2) {
    margin: clamp(2.4rem, 4vw, 3.1rem) 0 1.05rem;
    font-size: var(--fs-h2);
  }

  .ms-article-prose :global(h3) {
    margin: clamp(1.7rem, 3vw, 2.1rem) 0 0.8rem;
    font-size: var(--fs-lede);
  }

  .ms-article-prose :global(blockquote) {
    padding-left: 1.1rem;
    border-left: 2px solid color-mix(in srgb, var(--article-accent) 44%, transparent);
    color: var(--ms-muted);
    font-style: italic;
  }

  .ms-article-prose > :global(:first-child) {
    margin-top: 0;
  }

  .ms-article-prose :global(pre.astro-code) {
    margin: 1.2rem 0 1.5rem;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--ms-rule);
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--article-accent) 5%, var(--ms-sheet));
    font-size: var(--fs-label);
    line-height: 1.55;
  }

  .ms-article-prose :global(pre.astro-code span) {
    color: var(--shiki-light);
  }

  :global(html.dark) .ms-article-prose :global(pre.astro-code span) {
    color: var(--shiki-dark);
  }

  .ms-article-prose > :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.08em 0.12em 0 0;
    color: var(--article-accent);
    font-family: var(--ms-font-display);
    font-size: 3.35rem;
    line-height: 0.78;
  }

  @media (max-width: 980px) {
    .ms-article-header {
      grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
      align-items: start;
    }

    .ms-article-reading-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ms-article-reader-rail {
      position: static;
      padding: 0 0 0.7rem;
      border-bottom: 1px solid var(--ms-rule);
    }
  }

  @media (max-width: 640px) {
    .ms-article-header {
      grid-template-columns: 1fr;
    }

    .ms-article-plate {
      aspect-ratio: 3 / 2;
    }

    .ms-article-title-card {
      padding-left: 0.72rem;
    }

    .ms-article-title {
      font-size: var(--fs-h1);
      max-width: 16ch;
    }

    .ms-article-prose {
      font-size: var(--fs-small);
      line-height: 1.68;
    }

    .ms-article-prose > :global(p:first-of-type::first-letter) {
      font-size: 2.75rem;
    }
  }
</style>


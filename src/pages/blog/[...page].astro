---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ManuscriptHeader from "../../components/manuscript/ManuscriptHeader.astro";
import ManuscriptFooter from "../../components/manuscript/ManuscriptFooter.astro";
import { siteMeta } from "../../data/site.js";
import { domainColor, accentVar, tagLabel } from "../../lib/domainColor.js";
import "../../styles/manuscript.css";

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return paginate(posts, { pageSize: 5 });
}

const { page } = Astro.props;

const formatDate = (date) =>
  date.toLocaleDateString("en-US", { month: "short", year: "numeric" });

const readTimeParts = (rt) => {
  const m = (rt ?? "").match(/(\d+)/);
  return m ? { minutes: m[1] } : null;
};

const byYear = page.data.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

const pageTitle = page.currentPage === 1
  ? `Blog | ${siteMeta.name}`
  : `Blog — Page ${page.currentPage} | ${siteMeta.name}`;
---

<BaseLayout title={pageTitle} description="Field notes, reading notes, and whatever runs alongside the work.">
  <div class="manuscript-page">
    <div class="ms-shell">
      <ManuscriptHeader currentPath="/blog" />

      <main class="ms-archive">
        <header class="ms-archive-head">
          <div>
            <p class="ms-archive-kicker">Archive</p>
            <h1>Notes from the notebook.</h1>
          </div>
          <p class="ms-archive-note">
            Field notes, reading notes, and whatever runs alongside the work.
          </p>
          <p class="ms-archive-count">{page.total} pieces</p>
        </header>

        <div class="ms-rule-ornament ms-archive-rule" aria-hidden="true">
          <span class="ms-rule-ornament-line"></span>
          <svg class="ms-rule-ornament-mark" viewBox="0 0 48 12" fill="currentColor">
            <path d="M24 1 L28.4 6 L24 11 L19.6 6 Z" />
            <path d="M9 3.4 L11.8 6 L9 8.6 L6.2 6 Z" opacity="0.5" />
            <path d="M39 3.4 L41.8 6 L39 8.6 L36.2 6 Z" opacity="0.5" />
          </svg>
          <span class="ms-rule-ornament-line"></span>
        </div>

        {years.map((year) => (
          <section class="ms-archive-year" aria-labelledby={`year-${year}`}>
            <h2 class="ms-archive-year-label" id={`year-${year}`}>{year}</h2>
            <ol class="ms-archive-list" role="list">
              {byYear[year].map((post, index) => {
                const color = domainColor(post.data.tags);
                const accent = accentVar(color);
                const primaryTag = tagLabel(post.data.tags[0]);
                const readTime = readTimeParts(post.data.readingTime);
                return (
                  <li
                    class:list={["ms-archive-entry", `ms-archive-entry--${color}`]}
                    style={`--entry-accent: ${accent}`}
                  >
                    <a class="ms-archive-hit" href={`/blog/${post.slug}/`} aria-label={`Read ${post.data.title}`}></a>

                    <figure class="ms-archive-plate">
                      <img class="ms-plate-img ms-plate-img--light" src={post.data.image} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                      <img class="ms-plate-img ms-plate-img--dark" src={post.data.image.replace("-card.png", "-card-dark.png")} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                    </figure>

                    <article class="ms-archive-copy">
                      <p class="ms-archive-meta">
                        <span>{formatDate(post.data.date)}</span>
                        {readTime && (
                          <>
                            <span aria-hidden="true">/</span>
                            <span class="ms-archive-readtime">
                              <span class="ms-archive-readtime-n">{readTime.minutes}</span>
                              <span class="ms-archive-readtime-unit">min</span>
                            </span>
                          </>
                        )}
                        <span aria-hidden="true">/</span>
                        <span class="ms-archive-domain">{primaryTag}</span>
                      </p>
                      <h3><a href={`/blog/${post.slug}/`}>{post.data.title}<span aria-hidden="true"> →</span></a></h3>
                      <p>{post.data.description}</p>
                    </article>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}

        {page.lastPage > 1 && (
          <nav class="ms-archive-pagination" aria-label="Pagination">
            {page.url.prev
              ? <a class="ms-pagination-btn" href={page.url.prev}>← Newer</a>
              : <span class="ms-pagination-btn ms-pagination-btn--ghost">← Newer</span>
            }
            <span class="ms-pagination-count">{page.currentPage} / {page.lastPage}</span>
            {page.url.next
              ? <a class="ms-pagination-btn" href={page.url.next}>Older →</a>
              : <span class="ms-pagination-btn ms-pagination-btn--ghost">Older →</span>
            }
          </nav>
        )}
      </main>

      <ManuscriptFooter />
    </div>
  </div>
</BaseLayout>

<style>
  .ms-archive {
    position: relative;
    padding: clamp(1rem, 2.3vw, 1.8rem) 0 clamp(3rem, 6vw, 4.8rem);
  }

  .ms-archive::before {
    content: "";
    position: absolute;
    top: 3.2rem;
    right: clamp(4rem, 12vw, 9rem);
    width: clamp(3.1rem, 6vw, 4.5rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--domain-gold) 24%, transparent);
    border-radius: 46% 54% 50% 50%;
    opacity: 0.2;
    transform: rotate(-11deg);
    pointer-events: none;
  }

  .ms-archive-head {
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(16rem, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: end;
    padding: clamp(0.6rem, 1.6vw, 1.2rem) 0 clamp(0.5rem, 1vw, 0.8rem);
  }

  .ms-archive-rule {
    margin-bottom: clamp(0.4rem, 1vw, 0.7rem);
  }

  .ms-archive-kicker {
    margin: 0 0 0.32rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ms-archive-head h1 {
    margin: 0;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .ms-archive-note {
    margin: 0;
    max-width: 26rem;
    padding-left: 0.9rem;
    border-left: 1.5px solid color-mix(in srgb, var(--ms-secondary) 48%, transparent);
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-display);
    font-size: clamp(1rem, 1.6vw, 1.14rem);
    font-style: italic;
    font-weight: 450;
    letter-spacing: -0.015em;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .ms-archive-count {
    justify-self: end;
    margin: 0 0 0.15rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .ms-archive-year {
    margin-top: clamp(1.4rem, 2.8vw, 2.2rem);
  }

  .ms-archive-year-label {
    margin: 0 0 0.35rem;
    padding-bottom: 0.45rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .ms-archive-list {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ms-archive-entry {
    --entry-accent: var(--ms-secondary);
    position: relative;
    display: grid;
    grid-template-columns: clamp(10rem, 22vw, 15rem) minmax(0, 1fr);
    gap: 0 clamp(1.2rem, 2.8vw, 2rem);
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--ms-rule);
  }

  .ms-archive-entry:last-child {
    border-bottom: none;
  }

  .ms-archive-hit {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .ms-archive-entry :is(a:not(.ms-archive-hit)) {
    position: relative;
    z-index: 4;
  }

  /* A quiet paper plate holding a technical ink figure. Two theme variants of the
     art (dark-ink / cream-ink) are swapped by the .dark class. */
  .ms-archive-plate {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    padding: clamp(0.4rem, 1.3vw, 0.85rem);
    border: 1px solid var(--ms-rule);
    border-radius: 0.42rem;
    background: #e8ddc4;
    box-shadow: 0 8px 22px var(--ms-shadow);
  }

  html.dark .ms-archive-plate { background: #191212; }

  .ms-plate-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ms-plate-img--dark { display: none; }
  html.dark .ms-plate-img--light { display: none; }
  html.dark .ms-plate-img--dark { display: block; }

  .ms-archive-copy {
    min-width: 0;
    padding-left: clamp(1rem, 2vw, 1.3rem);
    border-left: 2px solid color-mix(in srgb, var(--entry-accent) 42%, transparent);
  }

  .ms-archive-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.36rem;
    margin: 0 0 0.5rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ms-archive-domain {
    color: var(--entry-accent);
  }

  .ms-archive-readtime {
    display: inline-flex;
    align-items: baseline;
    gap: 0.14em;
    padding: 0.16rem 0.38rem 0.14rem;
    border: 1px solid color-mix(in srgb, var(--entry-accent) 42%, transparent);
    border-radius: 0.22rem;
    background: color-mix(in srgb, var(--entry-accent) 11%, var(--ms-sheet));
    color: var(--entry-accent);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .ms-archive-readtime-n {
    font-size: 1.12em;
    font-variant-numeric: tabular-nums;
  }

  .ms-archive-readtime-unit {
    opacity: 0.82;
    font-size: 0.92em;
  }

  .ms-archive-copy h3 {
    margin: 0 0 0.4rem;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .ms-archive-copy a {
    color: inherit;
    text-decoration: none;
  }

  .ms-archive-copy a:hover,
  .ms-archive-copy a:focus-visible {
    color: var(--entry-accent);
  }

  .ms-archive-copy p:not(.ms-archive-meta) {
    margin: 0;
    color: var(--ms-on-surface-variant);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.5;
  }

  /* pagination */
  .ms-archive-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .ms-pagination-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--ms-rule);
    border-radius: 0.22rem;
    color: var(--ms-primary);
    font-family: var(--ms-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 200ms ease, border-color 200ms ease;
  }

  a.ms-pagination-btn:hover,
  a.ms-pagination-btn:focus-visible {
    color: var(--ms-secondary);
    border-color: var(--ms-secondary);
  }

  .ms-pagination-btn--ghost {
    opacity: 0.28;
    pointer-events: none;
  }

  .ms-pagination-count {
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  @media (max-width: 760px) {
    .ms-archive-head {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.65rem;
    }

    .ms-archive-count {
      justify-self: start;
    }

    .ms-archive-entry {
      grid-template-columns: clamp(8rem, 36vw, 10rem) minmax(0, 1fr);
      gap: 0.8rem 1rem;
    }
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ManuscriptHeader from "../components/manuscript/ManuscriptHeader.astro";
import ManuscriptFooter from "../components/manuscript/ManuscriptFooter.astro";
import BrandIcon from "../components/BrandIcon.astro";
import ResearchPlate from "../components/research/ResearchPlate.astro";
import { siteMeta, profileLinks } from "../data/site.js";
import { researchAreas, publications, shortAuthor } from "../data/research.js";
import { accentVar } from "../lib/domainColor.js";
import "../styles/manuscript.css";

const scholarLink = profileLinks.find((link) => link.icon === "scholar");
const posts = await getCollection("blog", ({ data }) => !data.draft);
const postBySlug = Object.fromEntries(posts.map((p) => [p.slug, p]));

const areas = researchAreas.map((area, index) => {
  const papers = publications.filter((p) => p.area === area.id).sort((a, b) => b.year - a.year);
  return {
    ...area,
    number: String(index + 1).padStart(2, "0"),
    accent: accentVar(area.accent),
    papers,
    posts: area.posts.map((slug) => postBySlug[slug]).filter(Boolean),
  };
});

const isCode = (href) => /github\.com/.test(href);
const isMe = (name) => /choudhary/i.test(name);
---

<BaseLayout title={`Research | ${siteMeta.name}`} description="Research areas and publications by Anshul Choudhary.">
  <div class="manuscript-page">
    <div class="ms-shell">
      <ManuscriptHeader currentPath="/research" />

    <main class="ms-research-page">
      <header class="ms-page-head">
        <h1>Research themes</h1>
      </header>

      <nav class="rs-index" aria-label="Research areas">
        {areas.map((area) => (
          <a class="rs-index-item" href={`#theme-${area.id}`} style={`--area-accent: ${area.accent}`}>
            <span class="rs-index-num">{area.number}</span>
            <span class="rs-index-label">{area.label}</span>
          </a>
        ))}
      </nav>

      <div class="rs-areas">
        {areas.map((area) => (
          <section id={`theme-${area.id}`} class="rs-area" style={`--area-accent: ${area.accent}`} aria-labelledby={`title-${area.id}`}>
            <figure class="rs-plate ms-glass-plate" style={`--plate-accent: ${area.accent}`}>
              <ResearchPlate kind={area.plate} />
            </figure>
            <div class="rs-area-text">
              <h2 id={`title-${area.id}`} class="rs-area-title">{area.title}</h2>
              <p class="rs-area-body">{area.body}</p>
              <ul class="rs-area-links">
                {area.papers.length > 0 && (
                  <li><a href={`#papers-${area.id}`}><svg class="rs-link-icon rs-link-icon--line" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5M8.5 13h7M8.5 17h5"/></svg>{area.papers.length === 1 ? "paper" : "papers"}</a></li>
                )}
                {(area.links ?? []).map((link) => (
                  <li><a href={link.href} target="_blank" rel="noreferrer">{isCode(link.href) && <BrandIcon icon="github" class="rs-link-icon" />}{link.label.toLowerCase()}</a></li>
                ))}
                {area.posts.map((post) => (
                  <li><a href={`/blog/${post.slug}/`} title={post.data.title}><svg class="rs-link-icon rs-link-icon--line" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/><path d="M14.5 5.5l3 3"/></svg>essay</a></li>
                ))}
              </ul>
            </div>
          </section>
        ))}
      </div>

      <section class="rs-pubs" aria-labelledby="publications-heading">
        <header class="rs-pubs-head">
          <h2 id="publications-heading">Papers</h2>
          {scholarLink && (
            <a class="rs-scholar" href={scholarLink.href} target="_blank" rel="noreferrer">
              Google Scholar <span aria-hidden="true">→</span>
            </a>
          )}
        </header>

        {areas.filter((area) => area.papers.length).map((area) => (
          <div id={`papers-${area.id}`} class="rs-shelf" style={`--area-accent: ${area.accent}`}>
            <h3 class="rs-shelf-label"><span class="rs-index-num">{area.number}</span><span class="rs-index-label">{area.label}</span></h3>
            <ol class="rs-pub-list">
              {area.papers.map((paper, i) => (
                <li class="rs-pub">
                  <div class="rs-pub-main">
                    <a class="rs-pub-title" href={`https://doi.org/${paper.doi}`} target="_blank" rel="noreferrer">{paper.title}</a>
                    <p class="rs-pub-authors">
                      {paper.authors.map((name, j) => (
                        <>{j > 0 && ", "}{isMe(name) ? <strong>{shortAuthor(name)}</strong> : shortAuthor(name)}</>
                      ))}
                      {paper.note && <span class="rs-pub-note"> ({paper.note})</span>}
                    </p>
                    <p class="rs-pub-meta"><strong>{paper.venue}</strong>, {paper.year}</p>
                    {paper.links.length > 0 && (
                      <p class="rs-pub-links">
                        {paper.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{isCode(link.href) && <BrandIcon icon="github" class="rs-link-icon" />}{link.label.toLowerCase()}</a>)}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    </main>

    <ManuscriptFooter />
    <script>
      // Run the oscillator plate only while it is on screen. astro:page-load fires on the first load
      // and after every client-side navigation (ClientRouter), so a swapped-in page gets observed too.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) e.target.classList.toggle("rp--live", e.isIntersecting);
      });
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll(".rp--ring").forEach((el) => io.observe(el));
      });
    </script>
    </div>
  </div>
</BaseLayout>

<style>
  .ms-research-page {
    display: grid;
    gap: clamp(1.6rem, 3.4vw, 2.6rem);
    padding: clamp(1rem, 2.3vw, 1.8rem) 0 clamp(3rem, 6vw, 4.8rem);
  }

  .ms-page-head {
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(16rem, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: end;
    padding: clamp(0.6rem, 1.6vw, 1.2rem) 0 0;
  }


  .ms-page-head h1,
  .rs-pubs-head h2 {
    margin: 0;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: var(--fs-h1);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  /* Area index: four numbered tabs, each underlined in its area's colour. */
  /* Accent as text: mixed toward ink so gold and sage stay legible on cream. */
  .rs-index-item,
  .rs-area,
  .rs-shelf {
    --area-ink: color-mix(in srgb, var(--area-accent) 58%, var(--ms-on-surface));
  }

  .rs-index {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ms-rule);
    border-bottom: 1px solid var(--ms-rule);
  }

  .rs-index-item {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1rem 1rem;
    border-left: 1px solid var(--ms-rule);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--area-accent) 70%, transparent);
    color: var(--ms-on-surface);
    text-decoration: none;
    transition: background 180ms ease;
  }

  .rs-index-item:first-child {
    border-left: 0;
  }

  .rs-index-item:hover,
  .rs-index-item:focus-visible {
    background: color-mix(in srgb, var(--area-accent) 8%, transparent);
  }

  .rs-index-num {
    color: var(--area-ink);
    font-family: var(--ms-font-mono);
    font-weight: 600;
  }

  .rs-index-num {
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rs-index-label {
    font-family: var(--ms-font-display);
    font-size: var(--fs-lede);
    line-height: 1.25;
  }

  .rs-areas {
    display: grid;
  }

  .rs-area {
    display: grid;
    grid-template-columns: minmax(15rem, var(--ms-plate-w)) minmax(0, 1fr);
    gap: clamp(1.4rem, 3.5vw, 3rem);
    align-items: start;
    padding: clamp(1.6rem, 3.4vw, 2.6rem) 0;
    border-bottom: 1px solid var(--ms-rule);
    scroll-margin-top: 1rem;
  }

  .rs-plate {
    margin: 0;
    padding: 0.7rem;
    overflow: hidden;
  }

  .rs-area-title {
    margin: 0 0 0.8rem;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .rs-area-body {
    margin: 0;
    max-width: 62ch;
    color: var(--ms-on-surface-variant);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  /* Short links separated by slashes, the way academic homepages list paper / code / essay. */
  .rs-area-links {
    display: flex;
    flex-wrap: wrap;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ms-muted);
    font-size: var(--fs-small);
  }

  :global(.rs-link-icon) {
    width: 1em;
    height: 1em;
    margin-right: 0.35em;
    vertical-align: -0.14em;
  }

  .rs-link-icon--line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rs-area-links li + li::before,
  .rs-pub-links a + a::before {
    content: "/";
    display: inline-block;
    padding-inline: 0.5em;
    color: var(--ms-muted);
    text-decoration: none;
  }

  .rs-area-links a,
  .rs-pub-links a {
    color: var(--area-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--area-accent) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 160ms ease;
  }

  .rs-area-links a:hover,
  .rs-area-links a:focus-visible,
  .rs-pub-links a:hover,
  .rs-pub-links a:focus-visible {
    text-decoration-color: var(--area-accent);
  }

  .rs-pubs {
    display: grid;
    gap: clamp(1.2rem, 2.6vw, 1.8rem);
    padding-top: clamp(0.6rem, 1.6vw, 1.2rem);
  }

  .rs-pubs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .rs-scholar {
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-mono);
    font-size: var(--fs-label);
    text-underline-offset: 0.22em;
  }

  /* Shelves sit on the same grid as the areas: label under the plate column, list under the text. */
  .rs-shelf {
    display: grid;
    grid-template-columns: minmax(15rem, var(--ms-plate-w)) minmax(0, 1fr);
    gap: clamp(1.4rem, 3.5vw, 3rem);
    align-items: start;
    scroll-margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ms-rule);
  }

  /* Same number + label as the area index at the top of the page. */
  .rs-shelf-label {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding-top: 1.25rem;
    color: var(--ms-on-surface);
    font-weight: 400;
  }

  .rs-pub-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rs-pub {
    padding: 1.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ms-rule) 70%, transparent);
  }



  .rs-pub-main {
    max-width: 62ch;
  }

  .rs-pub-title {
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-decoration: none;
  }

  .rs-pub-title:hover,
  .rs-pub-title:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--area-accent);
    text-underline-offset: 0.2em;
  }

  .rs-pub-authors,
  .rs-pub-meta,
  .rs-pub-links {
    margin: 0.4rem 0 0;
    color: var(--ms-on-surface-variant);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .rs-pub-authors strong {
    color: var(--ms-on-surface);
    font-weight: 650;
  }

  .rs-pub-note {
    color: var(--ms-muted);
  }

  .rs-pub-meta strong {
    color: var(--ms-on-surface);
    font-style: italic;
    font-weight: 650;
  }

  .rs-pub-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin-top: 1rem;
    font-size: var(--fs-small);
  }

  @media (max-width: 860px) {
    .rs-shelf,
    .rs-area {
      grid-template-columns: 1fr;
    }

    .rs-plate {
      max-width: var(--ms-plate-w);
    }
  }

  @media (max-width: 760px) {
    .ms-page-head {
      grid-template-columns: 1fr;
    }

    .rs-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rs-index-item:nth-child(3) {
      border-left: 0;
    }

    .rs-index-item:nth-child(n + 3) {
      border-top: 1px solid var(--ms-rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rs-index-item,
    .rs-area-links a,
    .rs-pub-links a {
      transition: none;
    }
  }
</style>

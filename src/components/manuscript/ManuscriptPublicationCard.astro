---
import { accentVar, publicationDomain } from "../../lib/domainColor.js";

const { item } = Astro.props;
const color = publicationDomain(item);
const accent = accentVar(color);
const authors = item.authors ?? [];
const links = item.links ?? [];
---

<article
  class:list={["pub-row", `pub-row--${color}`]}
  style={`--pub-accent: ${accent}`}
  role="listitem"
>
  <figure class="pub-row-plate">
    <img
      src={item.image}
      alt={item.imageAlt ?? ""}
      loading="lazy"
      decoding="async"
    />
    <span class="pub-row-wash" aria-hidden="true"></span>
  </figure>

  <div class="pub-row-content">
    <p class="pub-row-rail">
      <span class="pub-row-venue">{item.venue}</span>
      <span class="pub-row-rail-sep" aria-hidden="true"> · </span>
      <span class="pub-row-year">{item.year}</span>
    </p>

    {authors.length > 0 && (
      <p class="pub-row-authors">{authors.join(", ")}</p>
    )}

    <h3 class="pub-row-title">
      <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a>
    </h3>

    {item.summary && (
      <p class="pub-row-summary">{item.summary}</p>
    )}

    <div class="pub-row-links">
      <a class="pub-pill" href={item.href} target="_blank" rel="noreferrer">
        Paper <span aria-hidden="true">→</span>
      </a>
      {links.map((link) => (
        <a class="pub-pill pub-pill--secondary" href={link.href} target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .pub-row {
    --pub-accent: var(--ms-secondary);
    display: grid;
    grid-template-columns: clamp(13rem, 34%, 20rem) minmax(0, 1fr);
    gap: 0 clamp(1.4rem, 3vw, 2.4rem);
    align-items: start;
    padding: clamp(1.6rem, 3vw, 2.2rem) 0;
    border-bottom: 1px solid var(--ms-rule);
  }

  .pub-row:last-child {
    border-bottom: none;
  }

  /* figure */
  .pub-row-plate {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--pub-accent) 22%, transparent);
    border-radius: 0.42rem;
    background: color-mix(in srgb, var(--pub-accent) 10%, var(--ms-sheet));
    box-shadow: 0 8px 22px rgba(74, 52, 41, 0.09);
  }

  .pub-row-plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    opacity: 0.96;
    filter: saturate(0.96) contrast(1);
  }

  html.dark .pub-row-plate img {
    mix-blend-mode: normal;
    opacity: 0.9;
    filter: saturate(0.96) brightness(0.98) contrast(1.02);
  }

  .pub-row-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 60%,
      color-mix(in srgb, var(--ms-sheet) 18%, transparent)
    );
    pointer-events: none;
  }

  /* content column */
  .pub-row-content {
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
    padding-left: clamp(0.8rem, 1.6vw, 1.1rem);
    border-left: 2px solid color-mix(in srgb, var(--pub-accent) 36%, transparent);
  }

  .pub-row-rail {
    margin: 0;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .pub-row-venue {
    color: var(--pub-accent);
    font-style: italic;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .pub-row-rail-sep {
    opacity: 0.45;
  }

  .pub-row-year {
    opacity: 0.68;
  }

  .pub-row-authors {
    margin: 0;
    color: var(--pub-accent);
    font-family: var(--ms-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.35;
    opacity: 0.85;
  }

  .pub-row-title {
    margin: 0.08rem 0 0;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.22;
  }

  .pub-row-title a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .pub-row-title a:hover,
  .pub-row-title a:focus-visible {
    color: var(--pub-accent);
  }

  .pub-row-summary {
    margin: 0;
    color: var(--ms-on-surface-variant);
    font-size: clamp(0.9rem, 1.25vw, 0.98rem);
    font-style: italic;
    font-weight: 450;
    line-height: 1.58;
  }

  /* action pills */
  .pub-row-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin-top: 0.3rem;
  }

  .pub-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.28rem 0.68rem;
    border: 1px solid color-mix(in srgb, var(--pub-accent) 55%, transparent);
    border-radius: 0.22rem;
    background: color-mix(in srgb, var(--pub-accent) 9%, var(--ms-sheet));
    color: var(--pub-accent);
    font-family: var(--ms-font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .pub-pill:hover,
  .pub-pill:focus-visible {
    background: color-mix(in srgb, var(--pub-accent) 17%, var(--ms-sheet));
  }

  .pub-pill--secondary {
    border-color: color-mix(in srgb, var(--ms-rule) 90%, transparent);
    background: transparent;
    color: var(--ms-on-surface-variant);
  }

  .pub-pill--secondary:hover,
  .pub-pill--secondary:focus-visible {
    border-color: color-mix(in srgb, var(--pub-accent) 55%, transparent);
    color: var(--pub-accent);
  }

  @media (max-width: 720px) {
    .pub-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .pub-row-plate {
      aspect-ratio: 16 / 7;
    }

    .pub-row-content {
      padding-left: 0.72rem;
    }
  }
</style>

---
import { siGithub, siGooglescholar, siOrcid } from "simple-icons";
import { siteMeta, profileLinks } from "../../data/site.js";
import BrandIcon from "../BrandIcon.astro";

const brandColors = {
  scholar: `#${siGooglescholar.hex}`,
  github: `#${siGithub.hex}`,
  orcid: `#${siOrcid.hex}`,
  email: "#D44638",
};
---

<footer class="ms-footer">
  <div class="ms-rule-ornament" aria-hidden="true">
    <span class="ms-rule-ornament-line"></span>
    <svg class="ms-rule-ornament-mark" viewBox="0 0 48 12" fill="currentColor">
      <path d="M24 1 L28.4 6 L24 11 L19.6 6 Z" />
      <path d="M9 3.4 L11.8 6 L9 8.6 L6.2 6 Z" opacity="0.5" />
      <path d="M39 3.4 L41.8 6 L39 8.6 L36.2 6 Z" opacity="0.5" />
    </svg>
    <span class="ms-rule-ornament-line"></span>
  </div>

  <div class="ms-footer-row">
  <p class="ms-footer-line">
    <span class="ms-sign-name">{siteMeta.name}</span>
    <span class="ms-sign-year">© 2026</span>
  </p>

  <div class="ms-footer-links" aria-label="Profile links">
    {profileLinks.map((link) => (
      <a
        class={`ms-footer-link ms-footer-link--${link.icon}`}
        href={link.href}
        target="_blank"
        rel="noreferrer"
      >
        <BrandIcon icon={link.icon} class="ms-footer-icon" />
        <span>{link.label === "Google Scholar" ? "Google Scholar" : link.label}</span>
      </a>
    ))}
    <a class="ms-footer-link ms-footer-link--email" href={`mailto:${siteMeta.email}`}>
      <svg class="ms-footer-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 6.75h16v10.5H4z" fill="none" stroke="currentColor" stroke-width="1.7" />
        <path d="M5 7.5l7 5.25L19 7.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
      <span>Email</span>
    </a>
  </div>
  </div>
</footer>

<style
  define:vars={{
    brandScholar: brandColors.scholar,
    brandGithub: brandColors.github,
    brandOrcid: brandColors.orcid,
    brandEmail: brandColors.email,
  }}
>
  .ms-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.7rem 0 1.65rem;
    line-height: 1;
  }

  .ms-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.35rem 2rem;
  }

  .ms-footer-line {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.12rem 0.5rem;
    font-family: var(--ms-font-display);
    color: var(--ms-primary);
    line-height: 1;
  }

  .ms-sign-name {
    font-family: var(--ms-font-display);
    font-size: clamp(0.98rem, 1.28vw, 1.12rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--ms-primary);
  }

  .ms-sign-year {
    font-family: var(--ms-font-display);
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ms-muted);
  }

  .ms-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.95rem 1.35rem;
  }

  .ms-footer-link {
    --brand: var(--ms-primary);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.46rem;
    padding-bottom: 0.5rem;
    color: var(--ms-primary);
    font-family: var(--ms-font-mono);
    font-size: clamp(0.72rem, 0.92vw, 0.82rem);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--ms-primary) 34%, transparent);
    transition: color 200ms ease, border-color 200ms ease;
  }

  /* axis node: each link is a point on a phase-space rail */
  .ms-footer-link::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand);
    opacity: 0.5;
    transform: scale(0.8);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  /* trajectory draw-in on hover */
  .ms-footer-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1.5px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 260ms ease;
  }

  .ms-footer-link:hover,
  .ms-footer-link:focus-visible {
    color: var(--brand);
    border-bottom-color: transparent;
  }

  .ms-footer-link:hover::after,
  .ms-footer-link:focus-visible::after {
    transform: scaleX(1);
  }

  .ms-footer-link:hover::before,
  .ms-footer-link:focus-visible::before {
    opacity: 1;
    transform: scale(1.2);
  }

  :global(.ms-footer-icon),
  .ms-footer-icon {
    display: block;
    width: 1.08rem;
    height: 1.08rem;
    flex: 0 0 auto;
    color: var(--brand);
  }

  .ms-footer-link--scholar { --brand: var(--brandScholar); }
  .ms-footer-link--github { --brand: var(--brandGithub); }
  .ms-footer-link--orcid { --brand: var(--brandOrcid); }
  .ms-footer-link--email { --brand: var(--brandEmail); }

  :global(html.dark) .ms-footer-link--github {
    --brand: #f0f6fc;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ms-footer-icon {
      transition: transform 200ms ease;
    }

    .ms-footer-link:hover .ms-footer-icon,
    .ms-footer-link:focus-visible .ms-footer-icon {
      transform: translateY(-1px) scale(1.08);
    }
  }

  @media (max-width: 720px) {
    .ms-footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      line-height: 1.45;
    }

    .ms-footer-links {
      justify-content: flex-start;
      gap: 0.78rem 1.1rem;
    }

    .ms-footer-link {
      padding: 0.12rem 0;
    }
  }
</style>

---
import { careerNodes } from "../../data/career.js";
import { siteMeta } from "../../data/site.js";
import { cvPdf, cvUpdated } from "../../data/cv.js";
import { buildTimelineItems, stopAccent, stopMeta } from "../../data/aboutTimeline.js";

const items = buildTimelineItems(careerNodes);

let stopCount = 0;
---

<main class="about-main">

  <div class="ms-rule-ornament about-page-rule" aria-hidden="true" style="margin-bottom: clamp(1.5rem, 3vw, 2.2rem)">
    <span class="ms-rule-ornament-line"></span>
    <svg class="ms-rule-ornament-mark" viewBox="0 0 48 12" fill="currentColor">
      <path d="M24 1 L28.4 6 L24 11 L19.6 6 Z" />
      <path d="M9 3.4 L11.8 6 L9 8.6 L6.2 6 Z" opacity="0.5" />
      <path d="M39 3.4 L41.8 6 L39 8.6 L36.2 6 Z" opacity="0.5" />
    </svg>
    <span class="ms-rule-ornament-line"></span>
  </div>

  <section class="about-bio" aria-labelledby="about-bio-heading">
    <h2 id="about-bio-heading" class="visually-hidden">About</h2>

    <aside class="about-bio-rail" aria-label="Research themes">
      <p class="about-bio-rail-label">Themes</p>
      <p>cell fate<br/>behavior genetics<br/>dynamical systems<br/>machine learning</p>
    </aside>

    <div class="about-bio-prose">
      <p>
        I'm at the Jackson Laboratory in Farmington, Connecticut, working on two problems: cell fate
        decisions and mouse behavior. On the cell side, I care about the geometry of how cells commit to
        a fate — the trajectories, the basins, what happens when you perturb the system. On the behavior
        side, it's closer to forward genetics: phenotype mice, find structure in what they do, trace back
        to the genome.
      </p>
      <p>
        Before this I was a mechatronics engineer, then spent a few years in industry teaching myself
        physics at night before a PhD at IISER Mohali on dynamical systems and chaos. My first postdoc
        was with Ulrike Feudel at the Institute for Chemistry and Biology of the Marine Environment in
        Oldenburg — a small research town in northwest Germany, the North Sea not far, grey skies most
        of the year. I worked on synchronization in food webs there. Toward the end of that postdoc I
        was already looking for problems at the intersection of machine learning and dynamical systems —
        it felt like the natural next direction. Around that time I heard from Bill Ditto at NC State;
        he was looking for someone to help shape his lab toward AI × physics, which sounded like exactly
        what I was after. I joined and spent three years there doing that.
      </p>
      <p>
        After working through a range of problems at that intersection, I wanted something with different
        stakes — real messy data, and work that actually matters to people outside the field. That's what
        led to JAX.
      </p>
      <p class="about-principle">
        Predrag Cvitanović says a scientist owns the method, not the subject. That's the closest thing to
        a plan I ever had.
      </p>
      <p>
        What I'm up to now is on the <a href="/research/">research page</a>. (I also drink an indefensible
        amount of tea—the one variable I've never managed to control.)
      </p>
    </div>
  </section>

  <section class="about-timeline" aria-labelledby="about-timeline-heading" style="margin-top: clamp(2.5rem, 5vw, 3.5rem)">
    <h2 id="about-timeline-heading" class="visually-hidden">Career timeline</h2>
    <div class="about-spine" aria-hidden="true"></div>

    <ol class="about-events">
      {items.map((item) => {
        if (item.kind === "gap") {
          return (
            <li class="about-gap">
              <p class="about-gap-label">{item.label}</p>
            </li>
          );
        }

        const node = item.node;
        const accent = stopAccent(node.type);
        const meta = stopMeta[node.id];
        const side = stopCount % 2 === 0 ? "right" : "left";
        stopCount += 1;

        return (
          <li class:list={["about-event", `about-event--${side}`, `about-event--${accent}`]}>
            <span class="about-marker" aria-hidden="true"></span>

            <div class="about-branch">
              <p class="about-when">{node.period}</p>
              <h3 class="about-role">{node.role}</h3>
              <p class="about-where">
                {node.inst}
                <span class="about-where-sep" aria-hidden="true"> · </span>
                {node.loc}
              </p>
              {meta?.theme && (
                <p class="about-theme">
                  {meta.href
                    ? <a href={meta.href}>{meta.theme}</a>
                    : <span>{meta.theme}</span>}
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="about-cv-band" aria-label="Curriculum vitae">
    <div class="about-cv-band-meta">
      <p class="about-cv-kicker">Curriculum vitae · updated {cvUpdated}</p>
    </div>
    <a class="about-cv-download" href={cvPdf} download>
      Download PDF
    </a>
  </section>
</main>

<style>
  .about-main {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(1rem, 2vw, 1.5rem);
  }

  .about-cv-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.5rem;
    max-width: 52rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    padding: clamp(1.1rem, 2.2vw, 1.35rem) clamp(0.5rem, 2vw, 1rem) 0;
    border-top: 1px solid var(--ms-rule);
  }

  .about-cv-band-meta {
    min-width: 0;
  }

  .about-cv-kicker {
    margin: 0;
    font-family: var(--ms-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--domain-sage);
  }

  .about-cv-download {
    flex-shrink: 0;
    padding: 0.42rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--domain-oxide) 38%, transparent);
    border-radius: 0.22rem;
    background: color-mix(in srgb, var(--domain-oxide) 8%, var(--ms-sheet));
    color: var(--domain-oxide);
    font-family: var(--ms-font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease, color 140ms ease;
  }

  .about-cv-download:hover,
  .about-cv-download:focus-visible {
    border-color: color-mix(in srgb, var(--domain-oxide) 55%, transparent);
    background: color-mix(in srgb, var(--domain-oxide) 14%, var(--ms-sheet));
    color: var(--ms-primary);
  }

  /* Alternating branch tree */
  .about-timeline {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding: 0;
  }

  .about-spine {
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--ms-muted) 20%, transparent);
    transform: translateX(-50%);
  }

  .about-events {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-event {
    --stop-accent: var(--ms-secondary);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2.6rem 1fr;
    align-items: center;
    padding: 0 0 clamp(1.9rem, 3.8vw, 2.7rem);
  }

  .about-event--oxide { --stop-accent: var(--domain-oxide); }
  .about-event--blue  { --stop-accent: var(--domain-blue); }
  .about-event--sage  { --stop-accent: var(--domain-sage); }

  .about-event:last-child {
    padding-bottom: 0;
  }

  /* dot on the spine */
  .about-marker {
    grid-column: 2;
    grid-row: 1;
    z-index: 1;
    justify-self: center;
    align-self: center;
    width: 0.78rem;
    height: 0.78rem;
    border-radius: 50%;
    background: var(--stop-accent);
    box-shadow:
      0 0 0 2px var(--ms-bg),
      0 0 0 4px color-mix(in srgb, var(--stop-accent) 42%, transparent);
  }

  /* horizontal branch connector from dot to card */
  .about-event::after {
    content: "";
    position: absolute;
    top: 50%;
    height: 1px;
    width: 0.95rem;
    background: color-mix(in srgb, var(--stop-accent) 40%, transparent);
    transform: translateY(-50%);
  }

  .about-event--right::after { left: 50%; margin-left: 0.42rem; }
  .about-event--left::after  { right: 50%; margin-right: 0.42rem; }

  .about-branch {
    grid-row: 1;
    min-width: 0;
  }

  .about-event--right .about-branch {
    grid-column: 3;
    text-align: left;
  }

  .about-event--left .about-branch {
    grid-column: 1;
    text-align: right;
  }

  .about-when {
    margin: 0 0 0.28rem;
    color: var(--stop-accent);
    font-family: var(--ms-font-mono);
    font-size: clamp(0.68rem, 0.9vw, 0.76rem);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .about-role {
    margin: 0 0 0.24rem;
    font-family: var(--ms-font-display);
    font-size: clamp(1.14rem, 1.9vw, 1.34rem);
    font-weight: 650;
    line-height: 1.16;
    letter-spacing: -0.025em;
    color: var(--ms-primary);
  }

  .about-event--oxide .about-role {
    font-weight: 700;
  }

  .about-where {
    margin: 0;
    color: color-mix(in srgb, var(--ms-muted) 88%, var(--ms-on-surface));
    font-size: clamp(0.92rem, 1.3vw, 1rem);
    line-height: 1.45;
  }

  .about-where-sep {
    opacity: 0.5;
    margin: 0 0.3em;
  }

  .about-theme {
    margin: 0.5rem 0 0;
    font-family: var(--ms-font-mono);
    font-size: clamp(0.64rem, 0.88vw, 0.72rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-theme a,
  .about-theme span {
    color: color-mix(in srgb, var(--stop-accent) 82%, var(--ms-primary));
  }

  .about-theme a {
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--stop-accent) 30%, transparent);
    transition: color 160ms ease, border-color 160ms ease;
  }

  .about-theme a:hover,
  .about-theme a:focus-visible {
    color: var(--stop-accent);
    border-color: color-mix(in srgb, var(--stop-accent) 55%, transparent);
  }

  /* interval marker: a small centered label masking the spine */
  .about-gap {
    text-align: center;
    padding: 0 0 clamp(1.9rem, 3.8vw, 2.7rem);
  }

  .about-gap-label {
    display: inline-block;
    margin: 0;
    padding: 0 0.7rem;
    background: var(--ms-bg);
    font-family: var(--ms-font-mono);
    font-size: clamp(0.6rem, 0.82vw, 0.68rem);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ms-muted) 52%, transparent);
  }

  /* Page header */
  .about-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.85rem 2rem;
    padding: clamp(0.6rem, 1.6vw, 1.2rem) 0 clamp(0.8rem, 1.8vw, 1.2rem);
    border-bottom: 1px solid var(--ms-rule);
  }

  .about-head-kicker {
    margin: 0 0 0.32rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .about-head-title {
    margin: 0;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .about-head-lede {
    margin: 0;
    max-width: 28rem;
    color: var(--ms-on-surface-variant);
    font-size: clamp(0.94rem, 1.5vw, 1.06rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.28;
    align-self: flex-end;
  }

  .about-head-rule {
    margin: clamp(0.8rem, 1.8vw, 1.2rem) 0;
  }

  /* Bio reading grid */
  .about-bio {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 67ch);
    gap: clamp(1.2rem, 3vw, 2rem);
    align-items: start;
  }

  .about-bio-rail {
    position: sticky;
    top: 1rem;
    padding-top: 0.35rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.45;
    opacity: 0.72;
  }

  .about-bio-rail p {
    margin: 0;
    font-size: inherit;
    line-height: 1.5;
    color: inherit;
    text-wrap: pretty;
  }

  .about-bio-rail-label {
    margin: 0.75rem 0 0.2rem;
    color: var(--ms-secondary);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    opacity: 1;
  }

  .about-bio-rail-label:first-child {
    margin-top: 0;
  }

  /* Bio prose */
  .about-bio-prose {
    max-width: 67ch;
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-body);
    font-size: clamp(1.05rem, 1.45vw, 1.14rem);
    line-height: 1.78;
  }

  .about-bio-prose p {
    margin: 0;
    text-wrap: pretty;
  }

  .about-bio-prose p + p {
    margin-top: 1.35rem;
  }

  .about-bio-prose p:first-of-type::first-letter {
    float: left;
    margin: 0.08em 0.12em 0 0;
    color: var(--ms-secondary);
    font-family: var(--ms-font-display);
    font-size: 3.35rem;
    line-height: 0.78;
  }

  .about-principle {
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in srgb, var(--domain-blue) 35%, transparent);
  }

  .about-bio-prose a {
    color: var(--domain-blue);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--domain-blue) 42%, transparent);
    text-underline-offset: 0.14em;
  }

  .about-bio-prose a:hover,
  .about-bio-prose a:focus-visible {
    color: var(--ms-secondary);
    text-decoration-color: color-mix(in srgb, var(--ms-secondary) 55%, transparent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html.dark .about-whisper--outer {
    color: color-mix(in srgb, var(--ms-muted) 88%, var(--ms-on-surface-variant));
  }

  @media (max-width: 760px) {
    .about-bio {
      grid-template-columns: 1fr;
    }

    .about-bio-rail {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
      padding: 0 0 0.7rem;
      border-bottom: 1px solid var(--ms-rule);
    }

    .about-bio-rail-label {
      margin: 0;
      width: 100%;
    }

    .about-bio-prose p:first-of-type::first-letter {
      font-size: 2.75rem;
    }
  }

  @media (max-width: 640px) {
    .about-cv-band {
      align-items: flex-start;
    }

    .about-cv-download {
      width: 100%;
      text-align: center;
    }

    /* collapse the tree to a single left rail */
    .about-spine {
      left: 0.4rem;
      transform: none;
    }

    .about-event {
      grid-template-columns: 0.8rem 1fr;
      column-gap: 1.25rem;
      padding-bottom: 1.9rem;
      align-items: start;
    }

    .about-marker {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      margin-top: 0.3rem;
    }

    .about-event::after {
      left: 0.4rem;
      right: auto;
      margin: 0;
      width: 0.85rem;
      top: 0.65rem;
      transform: none;
    }

    .about-event--right .about-branch,
    .about-event--left .about-branch {
      grid-column: 2;
      text-align: left;
    }

    .about-gap {
      text-align: left;
      padding-left: 2rem;
    }

    .about-gap-label {
      padding: 0 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-theme a {
      transition: none;
    }
  }
</style>

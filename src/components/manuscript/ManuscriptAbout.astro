---
import { careerNodes } from "../../data/career.js";
import { siteMeta } from "../../data/site.js";
import { cvPdf, cvUpdated } from "../../data/cv.js";
import { buildTimelineItems, stopAccent, stopMeta } from "../../data/aboutTimeline.js";

const items = buildTimelineItems(careerNodes);

let stopCount = 0;
---

<main class="about-main">

  <div class="ms-rule-ornament about-page-rule" aria-hidden="true" style="margin-bottom: clamp(1.5rem, 3vw, 2.2rem)">
    <span class="ms-rule-ornament-line"></span>
    <svg class="ms-rule-ornament-mark" viewBox="0 0 48 12" fill="currentColor">
      <path d="M24 1 L28.4 6 L24 11 L19.6 6 Z" />
      <path d="M9 3.4 L11.8 6 L9 8.6 L6.2 6 Z" opacity="0.5" />
      <path d="M39 3.4 L41.8 6 L39 8.6 L36.2 6 Z" opacity="0.5" />
    </svg>
    <span class="ms-rule-ornament-line"></span>
  </div>

  <section class="about-bio" aria-labelledby="about-bio-heading">
    <h2 id="about-bio-heading" class="visually-hidden">About</h2>

    <div class="about-bio-prose">
      <p>
        I am an Associate Computational Scientist at The Jackson Laboratory in Farmington, Connecticut.
        My work centers on two areas: using dynamical systems to model cell fate decisions from single-cell
        genomics, and combining computer vision, machine learning, and mathematical models to quantify mouse
        behavior from video and connect it to its genetic origins.
      </p>
      <p>
        I started out in mechatronics engineering, spent two years in a corporate job teaching myself
        physics at night, and then did a PhD on nonlinear dynamics and chaos. That background shapes how
        I approach both problems—viewing biological data through the lens of high-dimensional state spaces,
        attractors, and perturbations.
      </p>
      <p class="about-principle">
        Predrag Cvitanović once remarked that a scientist owns the method, not the subject. That's
        the closest thing to a plan I've ever had.
      </p>
      <p>
        Publications and preprints are on the <a href="/research/">research page</a>; essays and
        notes are in the <a href="/blog/">notebook</a>.
      </p>
    </div>
  </section>

  <section class="about-timeline" aria-labelledby="about-timeline-heading" style="margin-top: clamp(2.5rem, 5vw, 3.5rem)">
    <h2 id="about-timeline-heading" class="visually-hidden">Career timeline</h2>
    <div class="about-spine" aria-hidden="true"></div>

    <ol class="about-events">
      {items.map((item) => {
        if (item.kind === "gap") {
          return (
            <li class="about-gap">
              <p class="about-gap-label">{item.label}</p>
            </li>
          );
        }

        const node = item.node;
        const accent = node.accent ?? stopAccent(node.id);
        const isCurrent = node.type === "current" || node.id === "jax";
        const meta = stopMeta[node.id];
        const side = stopCount % 2 === 0 ? "right" : "left";
        stopCount += 1;

        return (
          <li class:list={[
            "about-event",
            `about-event--${side}`,
            `about-event--${accent}`,
            isCurrent && "about-event--current"
          ]}>
            <span class="about-marker" aria-hidden="true"></span>

            <div class="about-branch">
              <p class="about-when">
                {isCurrent && <span class="about-live-dot" aria-hidden="true"></span>}
                {node.period}
              </p>
              <h3 class="about-role">{node.role}</h3>
              <p class="about-where">
                {node.inst}
                <span class="about-where-sep" aria-hidden="true"> · </span>
                {node.loc}
              </p>
              {meta?.theme && (
                <p class="about-theme">
                  {meta.href
                    ? <a href={meta.href}>{meta.theme}</a>
                    : <span>{meta.theme}</span>}
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="about-cv-band" aria-label="Curriculum vitae">
    <div class="about-cv-band-meta">
      <p class="about-cv-kicker">Curriculum vitae · updated {cvUpdated}</p>
    </div>
    <a class="about-cv-download" href={cvPdf} download>
      Download PDF
    </a>
  </section>
</main>

<style>
  .about-main {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(1rem, 2vw, 1.5rem);
  }

  .about-cv-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.5rem;
    max-width: 52rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    padding: clamp(1.1rem, 2.2vw, 1.35rem) clamp(0.5rem, 2vw, 1rem) 0;
    border-top: 1px solid var(--ms-rule);
  }

  .about-cv-band-meta {
    min-width: 0;
  }

  .about-cv-kicker {
    margin: 0;
    font-family: var(--ms-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ms-accent);
  }

  .about-cv-download {
    flex-shrink: 0;
    padding: 0.42rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ms-accent) 38%, transparent);
    border-radius: 0.22rem;
    background: color-mix(in srgb, var(--ms-accent) 8%, var(--ms-sheet));
    color: var(--ms-accent);
    font-family: var(--ms-font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease, color 140ms ease;
  }

  .about-cv-download:hover,
  .about-cv-download:focus-visible {
    border-color: color-mix(in srgb, var(--ms-accent) 55%, transparent);
    background: color-mix(in srgb, var(--ms-accent) 14%, var(--ms-sheet));
    color: var(--ms-primary);
  }

  /* Alternating branch tree */
  .about-timeline {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding: 0;
  }

  .about-spine {
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--ms-muted) 20%, transparent);
    transform: translateX(-50%);
  }

  .about-events {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-event {
    --stop-accent: var(--ms-secondary);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2.6rem 1fr;
    align-items: center;
    padding: 0 0 clamp(1.9rem, 3.8vw, 2.7rem);
  }

  .about-event--oxide { --stop-accent: var(--domain-oxide); }
  .about-event--teal  { --stop-accent: var(--domain-teal); }
  .about-event--sage  { --stop-accent: var(--domain-sage); }
  .about-event--plum  { --stop-accent: var(--domain-plum); }
  .about-event--gold  { --stop-accent: var(--domain-gold); }
  .about-event--blue  { --stop-accent: var(--domain-blue); }

  .about-event:last-child {
    padding-bottom: 0;
  }

  /* dot on the spine */
  .about-marker {
    grid-column: 2;
    grid-row: 1;
    z-index: 1;
    justify-self: center;
    align-self: center;
    position: relative;
    width: 0.78rem;
    height: 0.78rem;
    border-radius: 50%;
    background: var(--stop-accent);
    box-shadow:
      0 0 0 2px var(--ms-bg),
      0 0 0 4px color-mix(in srgb, var(--stop-accent) 42%, transparent);
  }

  /* horizontal branch connector from dot to card */
  .about-event::after {
    content: "";
    position: absolute;
    top: 50%;
    height: 1px;
    width: 0.95rem;
    background: color-mix(in srgb, var(--stop-accent) 40%, transparent);
    transform: translateY(-50%);
  }

  .about-event--right::after { left: 50%; margin-left: 0.42rem; }
  .about-event--left::after  { right: 50%; margin-right: 0.42rem; }

  .about-branch {
    grid-row: 1;
    min-width: 0;
  }

  .about-event--right .about-branch {
    grid-column: 3;
    text-align: left;
  }

  .about-event--left .about-branch {
    grid-column: 1;
    text-align: right;
  }

  .about-when {
    margin: 0 0 0.28rem;
    color: var(--stop-accent);
    font-family: var(--ms-font-mono);
    font-size: clamp(0.68rem, 0.9vw, 0.76rem);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .about-role {
    margin: 0 0 0.24rem;
    font-family: var(--ms-font-display);
    font-size: clamp(1.14rem, 1.9vw, 1.34rem);
    font-weight: 650;
    line-height: 1.16;
    letter-spacing: -0.025em;
    color: var(--ms-primary);
  }

  .about-event--current .about-role {
    font-weight: 700;
  }

  /* Current active status milestone */
  .about-event--current .about-marker {
    animation: live-marker-blink 2s ease-in-out infinite;
  }

  .about-event--current .about-marker::before {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid var(--stop-accent);
    animation: live-radar-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
  }

  .about-event--current .about-marker::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid var(--stop-accent);
    animation: live-radar-ping 2.2s cubic-bezier(0, 0, 0.2, 1) 1.1s infinite;
    pointer-events: none;
  }

  @keyframes live-radar-ping {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    60%, 100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @keyframes live-marker-blink {
    0%, 100% {
      opacity: 1;
      transform: scale(1.06);
      box-shadow:
        0 0 0 2px var(--ms-bg),
        0 0 0 5px color-mix(in srgb, var(--stop-accent) 55%, transparent),
        0 0 14px color-mix(in srgb, var(--stop-accent) 65%, transparent);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.9);
      box-shadow:
        0 0 0 2px var(--ms-bg),
        0 0 0 2px color-mix(in srgb, var(--stop-accent) 20%, transparent),
        0 0 2px transparent;
    }
  }

  /* Current branch connector line glow */
  .about-event--current::after {
    background: color-mix(in srgb, var(--stop-accent) 65%, transparent);
    animation: live-connector-pulse 2.2s ease-in-out infinite;
  }

  @keyframes live-connector-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* Blinking live beacon dot in the period label */
  .about-live-dot {
    display: inline-block;
    width: 0.46rem;
    height: 0.46rem;
    margin-right: 0.42rem;
    border-radius: 50%;
    background: var(--stop-accent);
    vertical-align: 0.08em;
    box-shadow: 0 0 8px color-mix(in srgb, var(--stop-accent) 80%, transparent);
    animation: live-dot-blink 1.4s ease-in-out infinite;
  }

  @keyframes live-dot-blink {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 8px color-mix(in srgb, var(--stop-accent) 80%, transparent);
    }
    50% {
      opacity: 0.2;
      transform: scale(0.68);
      box-shadow: 0 0 0px transparent;
    }
  }

  .about-where {
    margin: 0;
    color: color-mix(in srgb, var(--ms-muted) 88%, var(--ms-on-surface));
    font-size: clamp(0.92rem, 1.3vw, 1rem);
    line-height: 1.45;
  }

  .about-where-sep {
    opacity: 0.5;
    margin: 0 0.3em;
  }

  .about-theme {
    margin: 0.5rem 0 0;
    font-family: var(--ms-font-mono);
    font-size: clamp(0.64rem, 0.88vw, 0.72rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-theme a,
  .about-theme span {
    color: color-mix(in srgb, var(--stop-accent) 82%, var(--ms-primary));
  }

  .about-theme a {
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--stop-accent) 30%, transparent);
    transition: color 160ms ease, border-color 160ms ease;
  }

  .about-theme a:hover,
  .about-theme a:focus-visible {
    color: var(--stop-accent);
    border-color: color-mix(in srgb, var(--stop-accent) 55%, transparent);
  }

  /* interval marker: a small centered label masking the spine */
  .about-gap {
    text-align: center;
    padding: 0 0 clamp(1.9rem, 3.8vw, 2.7rem);
  }

  .about-gap-label {
    display: inline-block;
    margin: 0;
    padding: 0 0.7rem;
    background: var(--ms-bg);
    font-family: var(--ms-font-mono);
    font-size: clamp(0.6rem, 0.82vw, 0.68rem);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--ms-muted) 52%, transparent);
  }

  /* Page header */
  .about-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.85rem 2rem;
    padding: clamp(0.6rem, 1.6vw, 1.2rem) 0 clamp(0.8rem, 1.8vw, 1.2rem);
    border-bottom: 1px solid var(--ms-rule);
  }

  .about-head-kicker {
    margin: 0 0 0.32rem;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .about-head-title {
    margin: 0;
    color: var(--ms-primary);
    font-family: var(--ms-font-display);
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .about-head-lede {
    margin: 0;
    max-width: 28rem;
    color: var(--ms-on-surface-variant);
    font-size: clamp(0.94rem, 1.5vw, 1.06rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.28;
    align-self: flex-end;
  }

  .about-head-rule {
    margin: clamp(0.8rem, 1.8vw, 1.2rem) 0;
  }

  /* Bio reading */
  .about-bio {
    max-width: 48rem;
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(0.5rem, 2vw, 1rem) 0;
  }

  /* Bio prose */
  .about-bio-prose {
    max-width: 72ch;
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-body);
    font-size: clamp(1.12rem, 1.6vw, 1.22rem);
    line-height: 1.72;
  }

  .about-bio-prose p {
    margin: 0;
    text-wrap: pretty;
  }

  .about-bio-prose p + p {
    margin-top: 1.35rem;
  }

  .about-bio-prose p:first-of-type::first-letter {
    float: left;
    margin: 0.08em 0.12em 0 0;
    color: var(--ms-secondary);
    font-family: var(--ms-font-display);
    font-size: 3.35rem;
    line-height: 0.78;
  }

  .about-principle {
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in srgb, var(--ms-accent) 35%, transparent);
  }

  .about-bio-prose a {
    color: var(--ms-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ms-accent) 42%, transparent);
    text-underline-offset: 0.14em;
  }

  .about-bio-prose a:hover,
  .about-bio-prose a:focus-visible {
    color: var(--ms-accent-strong);
    text-decoration-color: var(--ms-accent-strong);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html.dark .about-whisper--outer {
    color: color-mix(in srgb, var(--ms-muted) 88%, var(--ms-on-surface-variant));
  }

  @media (max-width: 760px) {
    .about-bio-prose p:first-of-type::first-letter {
      font-size: 2.75rem;
    }
  }

  @media (max-width: 640px) {
    .about-cv-band {
      align-items: flex-start;
    }

    .about-cv-download {
      width: 100%;
      text-align: center;
    }

    /* collapse the tree to a single left rail with comfortable gutter for radar ripples */
    .about-timeline {
      padding-left: 0.75rem;
      padding-right: 0.5rem;
    }

    .about-spine {
      left: 1.15rem;
      transform: none;
    }

    .about-event {
      grid-template-columns: 0.8rem 1fr;
      column-gap: 1.25rem;
      padding-bottom: 1.9rem;
      align-items: start;
    }

    .about-marker {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      margin-top: 0.3rem;
    }

    .about-event::after {
      left: 1.15rem;
      right: auto;
      margin: 0;
      width: 0.85rem;
      top: 0.65rem;
      transform: none;
    }

    .about-event--right .about-branch,
    .about-event--left .about-branch {
      grid-column: 2;
      text-align: left;
    }

    .about-gap {
      text-align: left;
      padding-left: 2.75rem;
    }

    .about-gap-label {
      padding: 0 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-theme a {
      transition: none;
    }
    .about-event--current .about-marker,
    .about-event--current .about-marker::before,
    .about-event--current .about-marker::after,
    .about-event--current::after,
    .about-live-dot {
      animation: none !important;
    }
  }
</style>

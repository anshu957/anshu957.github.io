---
// A research area's plate: a small figure of the idea behind the area, drawn from its own equations
// (inline SVG at build time; the torus is a canvas, see torus.js). Ink is --ms-on-surface, the accent is --plate-accent,
// so both themes follow the page tokens. `kind`: landscape | pose | torus | ring.
const { kind } = Astro.props;

const W = 320;
const H = 220;
const f = (n) => n.toFixed(1);
const path = (pts) => pts.map(([x, y], i) => `${i ? "L" : "M"}${f(x)} ${f(y)}`).join("");
const range = (a, b, n) => Array.from({ length: n }, (_, i) => a + ((b - a) * i) / (n - 1));

// Deterministic noise, so the build is stable.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

let svg = {};

if (kind === "landscape") {
  // Waddington's landscape: rows of U(x, s) in perspective, developmental time s running toward the viewer.
  // One valley forks in two, then the right one forks again; a cell rolls down the rightmost path.
  const sig = (z) => 1 / (1 + Math.exp(-z));
  const wells = (s) => {
    const A = sig((s - 0.3) / 0.05);
    const B = sig((s - 0.62) / 0.05);
    return [-0.72 * A, 0.72 * A - 0.36 * B, 0.72 * A + 0.36 * B];
  };
  const U = (x, s) => {
    const D = 0.4 + 0.7 * s;
    const w = 0.15 + 0.1 * (1 - s);
    const g = wells(s).map((m) => D * Math.exp(-((x - m) ** 2) / (2 * w * w)));
    return 0.28 * x ** 4 - Math.log(g.reduce((acc, v) => acc + Math.exp(10 * v), 0)) / 10;
  };
  const proj = (x, s) => [160 + x * (80 + 26 * s), 62 + 112 * s - 32 * U(x, s)];
  const xs = range(-1.5, 1.5, 130);
  const N = 14;
  const rs = range(0, 1, N);
  const rows = rs.map((s, k) => {
    const pts = xs.map((x) => proj(x, s));
    const next = rs[k + 1];
    const seg = next === undefined ? null : path(range(s, next, 10).map((t) => proj(wells(t)[2], t)));
    return { line: path(pts), fill: `${path(pts)}L${f(pts.at(-1)[0])} ${H}L${f(pts[0][0])} ${H}Z`, seg };
  });
  const [bx, by] = proj(0, 0);
  svg = { rows, ball: [bx, by - 5.5] };
}

if (kind === "pose") {
  // Top-down mouse in an open field with the 12 keypoints a pose model tracks (nose, ears, neck, four paws,
  // spine, three along the tail), the path its body took, and its behavior syllables over time below.
  const ctrl = [[250, 118], [282, 72], [250, 32], [180, 26], [110, 36], [54, 52], [44, 100], [90, 124], [140, 98], [178, 80]];
  const pts = [ctrl[0], ...ctrl, ctrl.at(-1)];
  let track = `M${ctrl[0].join(" ")}`;
  for (let i = 1; i < pts.length - 2; i++) {
    const [p0, p1, p2, p3] = [pts[i - 1], pts[i], pts[i + 1], pts[i + 2]];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    track += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${p2[0]} ${p2[1]}`;
  }
  const kp = {
    nose: [36, 0], earL: [22, -9], earR: [22, 9], neck: [17, 0],
    paw1: [6, -15], paw2: [6, 15], spine: [-2, 0], paw3: [-19, -15], paw4: [-19, 15],
    tail0: [-28, 0], tail1: [-48, 5], tail2: [-68, 1],
  };
  const bones = [["nose", "neck"], ["earL", "neck"], ["earR", "neck"], ["neck", "spine"], ["spine", "tail0"],
    ["paw1", "neck"], ["paw2", "neck"], ["paw3", "tail0"], ["paw4", "tail0"]];
  const skel = bones.map(([u, v]) => `M${kp[u].join(" ")}L${kp[v].join(" ")}`).join("");
  const syllables = [];
  let sx = 20;
  while (sx < 300) {
    const w = 7 + Math.floor(rand() * 22);
    syllables.push({ x: sx, w: Math.min(w, 300 - sx), c: Math.floor(rand() * 4) });
    sx += w + 1.5;
  }
  svg = { track, kp: Object.values(kp), paws: [kp.paw1, kp.paw2, kp.paw3, kp.paw4], skel, syllables };
}

if (kind === "ring") {
  // A small-world ring of oscillators: most have fallen into step (accent), a few still drift.
  const N = 16;
  const nodes = range(0, 2 * Math.PI, N + 1).slice(0, -1).map((th, i) => ({
    x: 160 + 84 * Math.cos(th - Math.PI / 2),
    y: 110 + 84 * Math.sin(th - Math.PI / 2),
    sync: ![3, 4, 10, 13].includes(i),
    phase: [3, 4, 10, 13].includes(i) ? rand() * 360 : 0,
    speed: 14 + rand() * 16,
  }));
  const edges = nodes.map((n, i) => [n, nodes[(i + 1) % N]]);
  const shortcuts = [[0, 7], [2, 11], [5, 14], [9, 15]].map(([a, b]) => [nodes[a], nodes[b]]);
  svg = { nodes, edges, shortcuts };
}
---

{kind === "torus" ? (
  <canvas class="rp rp--torus" data-torus aria-hidden="true"></canvas>
) : (
<svg class={`rp rp--${kind}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true" focusable="false">
  {kind === "landscape" && (
    <g>
      {svg.rows.map((r) => (
        <g>
          <path class="rp-sheet" d={r.fill} />
          <path class="rp-ink rp-row" d={r.line} />
          {r.seg && <path class="rp-accent" d={r.seg} />}
        </g>
      ))}
      <circle class="rp-dot rp-ball" cx={svg.ball[0]} cy={svg.ball[1]} r="5.5" />
    </g>
  )}

  {kind === "pose" && (
    <g>
      <rect class="rp-arena" x="20" y="12" width="280" height="128" />
      <path class="rp-track" d={svg.track} />
      <g transform="translate(176 80) rotate(-22) scale(1.3)">
        {svg.paws.map(([x, y]) => <ellipse class="rp-paw" cx={x} cy={y} rx="4" ry="3" />)}
        <path class="rp-ink rp-tail" d="M-28 0 Q-38 6 -48 5 T-68 1" />
        <path class="rp-body" d="M36 0 C33 -4 27 -7 21 -7 C12 -8 4 -12 -8 -12 C-20 -12 -28 -7 -30 0 C-28 7 -20 12 -8 12 C4 12 12 8 21 7 C27 7 33 4 36 0Z" />
        <ellipse class="rp-body" cx="22" cy="-9" rx="3.6" ry="3" />
        <ellipse class="rp-body" cx="22" cy="9" rx="3.6" ry="3" />
        <path class="rp-skel" d={svg.skel} />
        {svg.kp.map(([x, y]) => <circle class="rp-kp" cx={x} cy={y} r="2.4" />)}
      </g>
      {svg.syllables.map((s) => (
        <rect class={`rp-syl rp-syl--${s.c}`} x={f(s.x)} y="156" width={f(s.w)} height="28" />
      ))}
    </g>
  )}

  {kind === "ring" && (
    <g>
      {svg.edges.map(([a, b]) => <path class="rp-ink rp-soft" d={`M${f(a.x)} ${f(a.y)} L${f(b.x)} ${f(b.y)}`} />)}
      {svg.shortcuts.map(([a, b]) => <path class="rp-accent rp-shortcut" d={`M${f(a.x)} ${f(a.y)} L${f(b.x)} ${f(b.y)}`} />)}
      {svg.nodes.map((n) => (
        <g transform={`translate(${f(n.x)} ${f(n.y)})`}>
          <circle class:list={["rp-osc", { "rp-osc--sync": n.sync }]} r="10.5" />
          <g class:list={["rp-hand", { "rp-hand--sync": n.sync }]} style={`--phase:${f(n.phase)}deg; --dur:${f(n.speed)}s`}>
            <path d="M0 0 L0 -7.5" />
          </g>
        </g>
      ))}
    </g>
  )}
</svg>
)}

<script>
  import { drawTori } from "./torus.js";
  document.querySelectorAll<HTMLCanvasElement>("canvas[data-torus]").forEach(drawTori);
</script>

<style>
  .rp {
    --ink: var(--ms-on-surface);
    --accent: var(--plate-accent, var(--ms-primary));
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rp-ink { stroke: var(--ink); stroke-width: 2; stroke-opacity: 0.85; }
  .rp-soft { stroke-opacity: 0.5; stroke-width: 1.6; }
  .rp-faint { stroke: var(--ink); stroke-opacity: 0.3; stroke-width: 1.2; stroke-dasharray: 2 3.5; }
  .rp-accent { stroke: var(--accent); stroke-width: 2.8; }
  .rp-sheet { fill: var(--ms-sheet); stroke: none; }
  .rp-dot { fill: var(--accent); stroke: none; }
  .rp-ball { stroke: var(--ink); stroke-width: 1.2; stroke-opacity: 0.7; }
  .rp-row { stroke-width: 1.5; }
  .rp--torus { aspect-ratio: 320 / 220; }

  .rp-arena { fill: none; stroke: var(--ink); stroke-opacity: 0.35; stroke-width: 1.4; }
  .rp-track { stroke: var(--accent); stroke-opacity: 0.75; stroke-width: 2; stroke-dasharray: 0.5 4.5; }
  .rp-body { fill: color-mix(in srgb, var(--accent) 22%, var(--ms-sheet)); stroke: var(--ink); stroke-opacity: 0.8; stroke-width: 1.8; }
  .rp-paw { fill: var(--ink); fill-opacity: 0.75; stroke: none; }
  .rp-tail { stroke-width: 1.8; }
  .rp-skel { stroke: var(--ink); stroke-opacity: 0.85; stroke-width: 1.5; }
  .rp-kp { fill: var(--accent); stroke: var(--ms-sheet); stroke-width: 1; }
  .rp-syl { stroke: none; }
  .rp-syl--0 { fill: var(--accent); }
  .rp-syl--1 { fill: color-mix(in srgb, var(--accent) 55%, var(--ink)); }
  .rp-syl--2 { fill: color-mix(in srgb, var(--accent) 45%, var(--ms-sheet)); }
  .rp-syl--3 { fill: color-mix(in srgb, var(--ink) 30%, var(--ms-sheet)); }

  .rp-shortcut { stroke-width: 1.8; stroke-opacity: 0.85; }
  .rp-osc { fill: var(--ms-sheet); stroke: var(--ink); stroke-opacity: 0.6; stroke-width: 1.6; }
  .rp-osc--sync { fill: color-mix(in srgb, var(--accent) 22%, var(--ms-sheet)); stroke: var(--accent); stroke-opacity: 1; stroke-width: 2; }
  .rp-hand path { stroke: var(--ink); stroke-opacity: 0.75; stroke-width: 2.2; }
  .rp-hand--sync path { stroke: var(--accent); stroke-opacity: 1; }
  .rp-hand { transform: rotate(var(--phase)); }

  /* The in-step oscillators turn together, slowly; the drifting ones each keep their own pace.
     Paused while the plate is off-screen (research.astro toggles .rp--live). */
  @media (prefers-reduced-motion: no-preference) {
    .rp-hand { animation: rp-spin var(--dur) linear infinite; animation-play-state: paused; }
    .rp-hand--sync { animation-duration: 24s; }
    .rp--live .rp-hand { animation-play-state: running; }
  }

  @keyframes rp-spin {
    from { transform: rotate(var(--phase)); }
    to { transform: rotate(calc(var(--phase) + 360deg)); }
  }
</style>

---
interface Ref {
  n: number;
  authors: string;
  year: number | string;
  title: string;
  venue: string;
  href: string;
}

interface Props {
  items: Ref[];
}

const { items } = Astro.props;
---

<section class="references" aria-labelledby="references-heading">
  <h2 id="references-heading">References</h2>
  <ol class="references-list">
    {
      items.map((item) => (
        <li id={`ref-${item.n}`}>
          <span class="ref-n">{item.n}.</span>
          <span class="ref-body">
            <span class="ref-authors">{item.authors}</span> ({item.year}).{" "}
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {item.title}
            </a>
            . <span class="ref-venue">{item.venue}</span>
            <a class="ref-back" href={`#cite-${item.n}`} aria-label="Back to text">
              ↩
            </a>
          </span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .references {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 3vw, 2.2rem);
    border-top: 1px solid var(--ms-rule);
  }

  .references h2 {
    margin: 0 0 1.2rem;
    color: var(--ms-primary);
    font-family: var(--ms-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .references-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .references-list li {
    display: flex;
    gap: 0.6rem;
    margin: 0 0 0.85rem;
    color: var(--ms-on-surface-variant);
    font-family: var(--ms-font-body);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .ref-n {
    flex: none;
    color: var(--ms-muted);
    font-family: var(--ms-font-mono);
    font-size: 0.82rem;
    opacity: 0.75;
  }

  .ref-authors {
    font-weight: 500;
  }

  .references-list a {
    color: var(--article-accent, var(--ms-secondary));
  }

  .ref-venue {
    font-style: italic;
    color: var(--ms-muted);
  }

  .ref-back {
    margin-left: 0.35rem;
    opacity: 0.55;
    text-decoration: none;
  }

  .ref-back:hover,
  .ref-back:focus-visible {
    opacity: 1;
  }
</style>
